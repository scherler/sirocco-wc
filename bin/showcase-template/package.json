{
  "name": "[NAME]",
  "version": "[VERSION]",
  "description": "[DESCRIPTION]",
  "author": "[AUTHOR]",
  "license": "[LICENSE]",
  "scripts": {
    "build": "yarn css:build && yarn build:bundle",
    "build:bundle": "parcel build --public-url ./ [MAIN]/[INDEX] --dist-dir [DEST]",
    "css:build": "sirocco-wc buildCss",
    "css:watch": "sirocco-wc watchCss",
    "lint": "eslint .",
    "prettier": "prettier \"[MAIN]/**/*.ts\" --fix --write",
    "mvnbuild": "yarn build",
    "test": "playwright test",
    "start": "yarn css:build && concurrently -k -r 'yarn start:server' 'yarn css:watch'",
    "start:server": "parcel index.html",
    ":add": "SWC_PREFIX=[PREFIX] sirocco-wc add"
  },
  "dependencies": {
    "@fontsource/material-symbols-outlined": "^5.3.7",
    "@fontsource/roboto": "^5.3.0",
    "@material/web": "^2.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@swc/helpers": "^0.5.23",
    "axios": "^1.20.0",
    "lit": "^3.3.3",
    "lit-html": "3.3.1",
    "[SNAME]": "^[SVERSION]",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@open-wc/eslint-config": "^13.1.0",
    "@open-wc/testing": "^4.0.0",
    "@parcel/plugin": "^2.16.4",
    "@parcel/transformer-js": "^2.16.4",
    "@parcel/transformer-typescript-types": "2.16.4",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "autoprefixer": "^10.6.1",
    "buffer": "^6.0.3",
    "concurrently": "^8.2.2",
    "escape-string-regexp": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-html": "^8.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-wc": "^3.1.0",
    "glob": "^10.5.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "parcel": "^2.16.4",
    "parcel-resolver-ts-base-url": "^1.3.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.7",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-plugin-css-modules": "^5.2.0"
  },
  "jest": {
    "preset": "ts-jest"
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 80,
    "singleAttributePerLine": true,
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "[MAIN]/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "browserslist": [
    "Chrome > 50"
  ],
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "glob": "^10.5.0",
    "inflight": "npm:@mapbox/node-inflight@^1.1.0",
    "tailwindcss": "^4.3.3"
  }
}
