{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["bin/*.js", "scripts/*.js"],
  "exclude": ["node_modules", "bin/template", "bin/showcase-template"]
}
